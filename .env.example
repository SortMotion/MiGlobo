# Variables para n8n (docker-compose.yml). Copia como .env
# Las variables de la app web están en web/.env.example

# URL pública de n8n (la del túnel de cloudflared o la del servidor), con / al final.
WEBHOOK_URL=https://xxxx.trycloudflare.com/

# Para usar {{ $env.SUPABASE_URL }} dentro de los nodos.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
